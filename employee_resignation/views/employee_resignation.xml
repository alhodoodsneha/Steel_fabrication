<?xml version="1.0" encoding="utf-8"?>
<odoo>


    <record id="view_form_employee_resignation" model="ir.ui.view">
        <field name="name">employee.resignation.form.view</field>
        <field name="model">employee.resignation</field>
        <field name="arch" type="xml">
            <form string="Resignation">
                <header>
                    <field name="state" widget="statusbar"
                           options="{'clickable': '0', 'fold_field': 'fold'}"
                           nolabel="1" readonly="1"/>
                    <button name="submit_application" string="Submit" type="object" invisible="state != 'new'"
                            class="btn-primary"/>
                    <button name="first_approve" string="Approve" type="object"
                            invisible="state != 'submit' or _is_first_approver == False" class="btn-primary"/>
                    <button name="reject_reason_add" string="reject" type="object"
                            invisible="state != 'submit' or _is_first_approver == False" class="btn-primary"/>
                    <button name="reject_reason_add_hr" string="reject" type="object"
                            invisible="state != 'first_approve'  or _is_second_approver == False" class="btn-primary"/>
                    <button name="second_approve" string="Approve" type="object"
                            invisible="state != 'first_approve' or _is_second_approver == False" class="btn-primary"/>
                    <button name="calculate_gratuity" string="Calculate Gratuity" type="object"
                            invisible="state != 'approved' or _is_second_approver == False or _gratuity_calculated == True"
                            class="btn-primary"/>
                </header>
                <sheet>
                    <h1>
                        <field name="employee_id"/>
                    </h1>
                    <group>
                        <group>
                            <field name="_gratuity_calculated" invisible="1"/>
                            <field name="is_reject" invisible="1"/>
                            <field name="_is_first_approver" invisible="1"/>
                            <field name="_is_second_approver" invisible="1"/>
                            <field name="user_id" invisible="1"/>
                            <field name="department_id" readonly="1"/>
                            <field name="manager" readonly="1"/>
                            <field name="company_id" readonly="1"/>
                            <field name="request_date" readonly="1"/>
                            <field name="resignation_date" readonly="1"/>
                        </group>
                        <group>
                            <label for="notice_period"></label>
                            <div>
                                <field name="notice_period" readonly="1" class="oe_inline"/>
                                <field name="notice_period_type" readonly="1" class="oe_inline"/>
                            </div>
                            <field name="last_working_day" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Reject Reason">
                            <field name="reason" required="1" readonly="state != 'new'"/>
                            <group string="Reject Reason" name="reject_reason" invisible="is_reject == False">
                                <field name="reject_reason" readonly="1"/>
                            </group>
                        </page>
                        <page string="Gratuity">
                            <field name="employee_gratuity_ids" readonly="1" widget="one2many"
                                   options="{'no_create': True, 'no_open': True}">
                                <tree string="Employee Gratuity" editable="bottom" create="0" delete="0" readonly="1"
                                      options="{'no_create': True, 'no_open': True}">
                                    <field name="user_id" column_invisible="1" options="{'no_open': True}"/>
                                    <field name="employee_id" column_invisible="1" options="{'no_open': True}"/>
                                    <field name="company_id" column_invisible="1" options="{'no_open': True}"/>
                                    <field name="currency_id" column_invisible="1" options="{'no_open': True}"/>
                                    <field name="employee_resignation" column_invisible="1"
                                           options="{'no_open': True}"/>
                                    <field name="joining_date" readonly="1"/>
                                    <field name="last_working_day" readonly="1"/>
                                    <field name="wage" readonly="1"/>
                                    <field name="gratuity" readonly="1"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="activity_ids"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_tree_resignation" model="ir.ui.view">
        <field name="name">employee.resignation.tree.view</field>
        <field name="model">employee.resignation</field>
        <field name="arch" type="xml">
            <tree string="Resignation" create="1" delete="1">
                <field name="_is_first_approver" column_invisible="1"/>
                <field name="_is_second_approver" column_invisible="1"/>
                <field name="user_id" column_invisible="1"/>
                <field name="employee_id" readonly="1"/>
                <field name="department_id" readonly="1"/>
                <field name="company_id" readonly="1"/>
                <field name="request_date" readonly="1"/>
                <field name="reason" required="1" readonly="state != 'new'"/>
                <field name="resignation_date" readonly="1"/>
                <field name="notice_period" readonly="1"/>
                <field name="last_working_day" readonly="1"/>
                <field name="state" widget='badge' decoration-success="state == 'approved'"
                       decoration-danger="state == 'reject'"
                       decoration-info="state == 'submit'" decoration-warning="state == 'first_approve'"/>
                <button name="first_approve" string="Approve" type="object" class="btn-primary"
                        invisible="state != 'submit' or _is_first_approver == False"/>
                <button name="second_approve" string="Approve" type="object" class="btn-primary"
                        invisible="state != 'first_approve' or _is_second_approver == False"/>
                <button name="reject_reason_add" string="reject" type="object"
                        invisible="state != 'submit' or _is_first_approver == False" class="btn-primary"/>
                <button name="reject_reason_add_hr" string="reject" type="object"
                        invisible="state != 'first_approve'  or _is_second_approver == False" class="btn-primary"/>
            </tree>
        </field>
    </record>


    <!-- Action to open the list view of estimation model -->
    <record id="action_resignation_employee" model="ir.actions.act_window">
        <field name="name">Resignation</field>
        <field name="res_model">employee.resignation</field>
        <field name="view_mode">tree,form</field>
        <field name="view_id" ref="view_tree_resignation"/>
        <field name="help" type="html">
            <p>
                Create Resignation of employee
            </p>
        </field>
    </record>
    <menuitem id="menu_resignation_root"
              name="Resignation"
              active="True"
              sequence="10">

        <menuitem
                name="Resignation"
                id="menu_resignation_employee"
                sequence="13"
        >
            <menuitem
                    name="Resignation"
                    id="menu_resignation"
                    action="action_resignation_employee"
                    sequence="14"
            />
        </menuitem>

    </menuitem>
</odoo>