<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_employee_form_inherited_hrms" model="ir.ui.view">
        <field name="name">hr.employee.view.inherited.hrms.form</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='work_location_id']" position="after">
                <field name="joining_date"/>
                <label for="notice_period"></label>
                <div>
                    <field name="notice_period" class="oe_inline"/>
                    <field name="notice_period_type" style="width:50%;"  class="oe_inline"/>
                </div>
                 <field name="last_working_day" readonly="1"/>
            </xpath>
        </field>
    </record>
</odoo>