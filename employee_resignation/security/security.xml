<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_employee_resignation_self_and_manager" model="ir.rule">
        <field name="name">Employee: See own and managed resignations</field>
        <field name="model_id"
               ref="employee_resignation.model_employee_resignation"/>
        <field name="domain_force">['|', ('user_id', '=', user.id), ('manager.user_id', '=', user.id)]
        </field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/> <!-- Regular users -->
    </record>

    <!-- Record rule to allow HR Managers and Admins to see all resignations -->
    <record id="rule_hr_manager_all_resignation" model="ir.rule">
        <field name="name">HR Manager and Admin: See all resignations</field>
        <field name="model_id"
               ref="employee_resignation.model_employee_resignation"/>
        <field name="domain_force">[]</field> <!-- Allow access to all records -->
        <field name="groups"
               eval="[(4, ref('hr.group_hr_manager')), (4, ref('base.group_system'))]"/> <!-- HR Manager and Admin groups -->
    </record>
</odoo>