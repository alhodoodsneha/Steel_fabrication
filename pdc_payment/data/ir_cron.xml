<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <odoo>
    <data noupdate="1">
        <record id="ir_cron_pdc_submitted_reminder" model="ir.cron">
            <field name="name">PDC Submitted Reminder</field>
            <field name="model_id" ref="model_pdc_payment_submit"/>
            <field name="state">code</field>
            <field name="code">
                model.send_reminder_pdc_submitted()
            </field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
        </record>

        <record id="ir_cron_pdc_received_reminder" model="ir.cron">
            <field name="name">PDC Received Reminder</field>
            <field name="model_id" ref="model_pdc_payment_received"/>
            <field name="state">code</field>
            <field name="code">
                model.send_reminder_pdc_received()
            </field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
        </record>
    </data>
</odoo>

</odoo>