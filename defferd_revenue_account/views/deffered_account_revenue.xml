<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_deferred_revenue_entry_form" model="ir.ui.view">
        <field name="name">deferred.entry.revenue.form.view</field>
        <field name="model">deferred.entry.revenue</field>
        <field name="arch" type="xml">
            <form string="Deferred Revenue">
                <header>
                </header>
                <sheet>
                    <h1>
                        <field name="account_move_id"/>
                    </h1>
                    <group>
                        <group>
                            <field name="start_date" readonly="1"/>
                            <field name="journal_id" readonly="1"/>
                            <field name="amount" readonly="1"/>
                            <field name="company_id" invisisble="1"/>
                        </group>
                        <group>
                            <field name="end_date" required="1"/>
                            <field name="period" required="1"/>
                            <field name="credit_acc" required="1"/>
                            <field name="debit_acc" required="1"/>
                            <field name="company_currency_id" invisisble="1"/>
                            <field name="partner_id" invisisble="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page id="deferred_line" string="Deferred Revenue Entries" name="deferred_lines">
                            <field name="line_ids" widget="one2many">
                                <tree string="Deferred Line" editable="bottom" delete="0" create="0">
                                    <field name="deferred_account" column_invisible="1"/>
                                    <field name="_is_posted" column_invisible="1"/>
                                    <field name="is_debit" column_invisible="1"/>
                                    <field name="is_corrected" column_invisible="1"/>
                                    <field name="company_id" column_invisible="1"/>
                                    <field name="company_currency_id" column_invisible="1"/>
                                    <field name="is_credit" column_invisible="1"/>
                                    <field name="account_move_id" column_invisible="1"/>
                                    <field name="schedule_date" readonly="1"/>
                                    <field name="account_id" readonly="1"/>
                                    <field name="partner_id" readonly="1"/>
                                    <field name="debit" readonly="1"  sum="Total Debit"/>
                                    <field name="credit" readonly="1"  sum="Total Credit"/>
                                    <field name="status" widget="badge" decoration-info="status == 'draft'"
                                           decoration-success="status == 'post'"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_tree_deferred_revenue" model="ir.ui.view">
        <field name="name">deferred.entry.revenue.tree.view</field>
        <field name="model">deferred.entry.revenue</field>
        <field name="arch" type="xml">
            <tree string="Deferred Revenue" create="0" delete="0">
                <field name="account_move_id" readonly="1"/>
                <field name="start_date" readonly="1"/>
                <field name="end_date" readonly="1"/>
                <field name="amount" readonly="1"/>
                <field name="period" readonly="1"/>
                <field name="journal_id" readonly="1"/>
                <field name="company_id" column_invisible="1"/>
                <field name="company_currency_id" column_invisible="1"/>
            </tree>
        </field>
    </record>


    <!-- Action to open the list view of estimation model -->
    <record id="action_deferred_revenue" model="ir.actions.act_window">
        <field name="name">Deferred Revenue</field>
        <field name="res_model">deferred.entry.revenue</field>
        <field name="view_mode">tree,form</field>
        <field name="view_id" ref="view_tree_deferred_revenue"/>
        <field name="help" type="html">
            <p>
                Create and Manage Deferred Revenue
            </p>
        </field>
    </record>

    <menuitem
            name="Deferred Revenue"
            id="menu_deferred_revenue"
            parent="account.menu_finance_entries_management"
            action="action_deferred_revenue"
            sequence="12"
    />

</odoo>