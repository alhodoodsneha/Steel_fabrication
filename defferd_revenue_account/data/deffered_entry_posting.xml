<odoo>
    <data noupdate="1">
        <!-- Scheduler to run every day at 2 AM -->
        <record id="ir_cron_deferred_entry_posting" model="ir.cron">
            <field name="name">Deferred Entry Posting</field>
            <field name="model_id" ref="model_deferred_entry_revenue"/>
            <field name="state">code</field>
            <field name="code">model.create_journal_entry_for_today()</field>
            <field name="active">True</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
        </record>
    </data>
</odoo>