<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_employee_form_inherited_for_sif" model="ir.ui.view">
        <field name="name">hr.employee.view.form.inherit.uae.sif.report</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='category_ids']" position="after">
                <group>
                    <group>
                        <field name="employee_unique_id"/>
                    </group>
                    <group>
                        <field name="personal_no"/>
                    </group>
                    <group>
                        <field name="agent_routing_id"/>
                    </group>
                    <group>
                        <field name="employee_account_with_agent"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>
</odoo>