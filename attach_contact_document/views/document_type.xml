<?xml version="1.0" encoding="utf-8"?>
<odoo>


    <record id="partner_document_type_view_form" model="ir.ui.view">
        <field name="name">partner.document.type.view.form</field>
        <field name="model">partner.document.type</field>
        <field name="arch" type="xml">
            <form string="Document Name">
                <sheet>
                    <group>
                        <field name="name"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <!--    Tree view of document_type model.-->
    <record id='partner_document_type_view_tree' model='ir.ui.view'>
        <field name="name">partner.document.type.view.tree</field>
        <field name="model">partner.document.type</field>
        <field name="arch" type="xml">
            <tree editable="bottom">
                <field name="name"/>
            </tree>
        </field>
    </record>
    <!--   Action of document type model.-->
    <record id="parent_document_type_action" model="ir.actions.act_window">
        <field name="name">Customer Document Types</field>
        <field name="res_model">partner.document.type</field>
        <field name="view_mode">tree,form</field>
    </record>


    <menuitem id="partner_document_type_menu"
              name="Customer Document Types"
              parent="contacts.res_partner_menu_config"
              sequence="3"
              action="parent_document_type_action"/>
</odoo>