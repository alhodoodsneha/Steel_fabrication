<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <template id="report_offer_letter_template">
            <t t-call="web.basic_layout">
                <div t-attf-class="header" t-att-style="report_header_style">
                    <div class="row">
                        <div class="col-6" style="text-align: left;">
                            <div class="o.company_id-logo" style="text-align: left;">
                                <img t-if="env.company.logo" t-att-src="image_data_uri(env.company.logo)"
                                     style="max-height: 99px;align-content:center !important;" alt="Logo"/>
                            </div>
                        </div>
                        <div class="col-6" style="text-align: right;">
                            <div class="company-info">
                                <ul class="list-unstyled">
                                    <li>
                                        <t t-esc="env.company.partner_id"
                                           t-options='{"widget": "contact", "fields": ["address", "name"], "no_marker": true}'/>
                                    </li>
                                    <li t-if="forced_vat">
                                        <t t-esc="env.company.country_id.vat_label or 'Tax ID'"/>:
                                        <span t-esc="forced_vat"/>
                                    </li>
                                </ul>
                            </div>
                        </div>
                    </div>
                    <div style="border-top: 1px solid lightgray; margin-bottom: 10px;"></div>
                </div>
                <div class="mt-0">
                    <div class="page">
                        <h2 style="text-align: center;">OFFER LETTER</h2>
                        <br></br>
                        <br></br>
                        <br></br>
                        <div class="into_page" style="position: relative; height: 100%; width: 100%;padding-left:30px;">
                            <span>Ref: <t t-esc="o.sequence"/> </span>
                            <br/>
                            <span>Date:
                                <t t-esc="o.get_ordinal_date()"/>
                            </span>
                            <br></br>
                            <span>
                                <strong>
                                    <t t-esc="o.partner_name"/>
                                </strong>
                            </span>
                            <br/>
                            <span><t t-esc="o.emp_state_id.name"/>-
                                <t t-esc="o.emp_country_id.name"/>.
                            </span>
                            <br></br>
                            <br></br>
                            <br></br>
                            <span>Dear
                                <strong>
                                    <t t-esc="o.partner_name"/>
                                </strong>
                                ,
                            </span>
                        </div>
                        <br/>
                        <div>
                            <span>Further to your application and consequent interview with our officials , we have
                                pleasure in offering you (
                                <strong>
                                    <t t-esc="o.partner_name"/>
                                </strong>
                                ) employment in our organization on the following terms and
                                conditions.
                            </span>
                        </div>
                        <br></br>
                        <div class="detail_page"
                             style="position: relative; height: 100%; width: 100%;padding-left:30px;">
                            <span>1. <strong>Designation: </strong> you will be designated as
                                <strong><t t-esc="o.job_id.name"/>.
                                </strong>
                            </span>
                            <br/>
                            <span>2.
                                <strong>Job Description: </strong>
                                <t t-esc="o.job_id.description"/>
                            </span>
                            <br/>
                            <span>3. <strong>Basic Salary: </strong>You will be paid a Basic Salary of UAE
                                <strong>AED</strong>
                                <t t-esc="o.salary_proposed"/>/- (
                                <t t-esc="o.amount_to_words(o.salary_proposed)"/>
                                only) per month.
                            </span>
                            <br/>
                            <span>4.
                                <strong>Other Allowance: AED-
                                    <t t-esc="o.other_allowance_emp"/>
                                </strong>
                                /- (
                                <t t-esc="o.amount_to_words(o.other_allowance_emp)"/>
                                only)
                                monthly will be provided by the company.
                            </span>
                            <br/>
                            <span>5. <strong>Transportation: </strong>Company will provided.
                            </span>
                            <br/>
                            <span>6. <strong>Accommodation: </strong>By your self.
                            </span>
                            <br/>
                            <span>7 <strong>Annual Ticket Allowance: </strong>Company will provide Leave salary and
                                Annual ticket allowance after One year completion in company.
                            </span>
                            <br/>
                            <span>8. <strong>Leave &amp; Gratuity: </strong>AS per UAE Federal Labor Law.
                            </span>
                            <br/>
                            <span>9. <strong>Effective Date Of Joining: </strong>Immediately on receipt of your
                                Employment visa.
                            </span>
                            <br/>
                            <span>10. <strong>Probation: </strong>You will be on probation for a period of six(6) months
                                from the date of joining the company.
                            </span>
                        </div>
                        <br></br>
                        <div style="position: relative; height: 100%; width: 100%;padding-left:30px;"
                             class="thanks_page">
                            <br></br>
                            Thanks &amp; regards,
                            <div class="row">
                                <br></br>
                                <br></br>
                                <span>Mr.Shabeer Ahamed</span>
                                <span>Managing Director</span>
                                <br/>
                                <span>Mob : -052 106 1978</span>
                            </div>
                        </div>

                    </div>
                </div>
                <div t-attf-class="footer o_standard_footer">
                    <div class="text-center">
                        <div style="border-top: 2px solid black; margin-bottom: 10px;"></div>
                        <div t-if="report_type == 'pdf'" class="text-muted">
                            Page:
                            <span class="page"/>
                            of
                            <span class="topage"/>
                        </div>
                        <div t-if="report_type == 'pdf' and display_name_in_footer" class="text-muted">
                            <span t-field="o.name"/>
                        </div>
                    </div>
                </div>
            </t>
        </template>

        <template id="report_offer_letter">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="o">
                    <t t-call="hr_recruitment_customization.report_offer_letter_template"/>
                </t>
            </t>
        </template>
    </data>
</odoo>