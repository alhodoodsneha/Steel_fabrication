<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_form_production_team" model="ir.ui.view">
        <field name="name">production.team.member.form.view</field>
        <field name="model">production.team.member</field>
        <field name="arch" type="xml">
            <form string="Production Team">
                <header>
                </header>
                <sheet>
                    <label for="name"/>
                    <h1>
                        <field name="name"/>
                    </h1>
                    <group>
                        <group>
                            <field name="team_manager_id"/>
                            <field name="team_member_ids" widget="many2many_tags"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_tree_production_team" model="ir.ui.view">
        <field name="name">production.team.member.tree.view</field>
        <field name="model">production.team.member</field>
        <field name="arch" type="xml">
            <tree string="production Team" create="1" delete="1">
                <field name="name"/>
                <field name="team_manager_id"/>
                <field name="team_member_ids"  widget="many2many_tags"/>
            </tree>
        </field>
    </record>


    <!-- Action to open the list view of estimation model -->
    <record id="action_production_team" model="ir.actions.act_window">
        <field name="name">production Team</field>
        <field name="res_model">production.team.member</field>
        <field name="view_mode">tree,form</field>
        <field name="view_id" ref="view_tree_production_team"/>
        <field name="help" type="html">
            <p>
                Create and manage your Engineering team
            </p>
        </field>
    </record>

    <menuitem
            name="Production Team"
            id="menu_production_team"
            parent="project.menu_project_config"
            action="action_production_team"
            sequence="13"
    />

</odoo>