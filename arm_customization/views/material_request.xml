<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_form_material_request_form" model="ir.ui.view">
        <field name="name">material.request.item.form.view</field>
        <field name="model">material.request.item</field>
        <field name="arch" type="xml">
            <form string="Material Request">
                <header>
                    <button name="action_first_approve_request" string="Approve"
                            type="object" class="oe_highlight" data-hotkey="o"
                            invisible="state != 'new'" groups="arm_customization.group_material_request_approver"/>
                    <button name="action_create_rfq" string="Create RFQ" type="object" class="oe_highlight"
                            data-hotkey="o"/>
                    <button name="action_reject_request" string="Reject"
                            type="object" class="oe_highlight" data-hotkey="o"
                            invisible="state != 'new'" groups="arm_customization.group_material_request_approver"/>
                    <field name="state" widget="statusbar"
                           options="{'clickable': '0', 'fold_field': 'fold'}"
                           nolabel="1" readonly="1"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_rfq_all" type="object"
                                class="oe_stat_button" icon="fa-building" string="RFQ">
                            <div class="o_stat_info">
                                <span class="o_stat_text">RFQ</span>
                            </div>
                        </button>
                    </div>
                    <h1>
                        <field name="sequence" readonly="1"/>
                    </h1>
                    <group>
                        <group>
                            <field name="project_id" readonly="1"/>
                            <field name="task_id" readonly="1"/>
                            <field name="user_id" readonly="1"/>
                            <field name="requisition_deadline" readonly="state != 'new'"/>
                        </group>
                        <group>
                            <field name="date" readonly="1"/>
                            <field name="mrp_id" invisible="1"/>
                            <field name="state" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Material Request" name="material_request_ids">
                            <field name="request_line_ids" widget="one2many" readonly="1">
                                <tree string="Request Line" editable="0" create="0" delete="0">
                                    <field name="material_item_id" column_invisible="1"/>
                                    <field name="state" column_invisible="1"/>
                                    <field name="item_id" readonly="1"/>
                                    <field name="description" readonly="1"/>
                                    <field name="kg_linear" readonly="1"/>
                                    <field name="length" readonly="1"/>
                                    <field name="width" readonly="1"/>
                                    <field name="uom_id" readonly="1"/>
                                    <field name="quantity" readonly="1"/>
                                    <field name="spec" readonly="1"/>
                                    <field name="total_weight" readonly="1"/>
                                    <button name="action_view_on_hand" string="On Hand Quantity"
                                            type="object" class="oe_highlight" data-hotkey="o"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Other Information" name="other_information">
                            <group>
                                <group>
                                    <group>
                                        <field name="approved_by" readonly="1"/>
                                        <field name="pm_approve_date" readonly="1"/>
                                    </group>
                                    <group>
                                        <field name="rejected_by" readonly="1"/>
                                        <field name="rejected_date" readonly="1"/>
                                    </group>
                                </group>
                                <group>
                                </group>
                            </group>
                            <separator string="Requisition Reason"/>
                            <field name="requisition_reason" readonly="state != 'new'"/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="activity_ids"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_material_request_tree" model="ir.ui.view">
        <field name="name">material.request.item.tree.view</field>
        <field name="model">material.request.item</field>
        <field name="arch" type="xml">
            <tree string="Material Request" create="1" delete="0">
                <field name="sequence" readonly="1"/>
                <field name="task_id" readonly="1"/>
                <field name="project_id" readonly="1"/>
                <field name="date" readonly="1"/>
                <field name="user_id" readonly="1"/>
                <button name="action_create_rfq" string="Create RFQ" type="object" class="oe_highlight"/>
            </tree>
        </field>
    </record>

    <record id="view_material_request_item_tree" model="ir.ui.view">
        <field name="name">material.request.line.item.tree.view</field>
        <field name="model">material.request.line.item</field>
        <field name="arch" type="xml">
            <tree string="Material Request" create="1" delete="0">
                <field name="material_item_id" readonly="1" string="Material Request"/>
                <field name="task_id" readonly="1"/>
                <field name="project_id" readonly="1"/>
                <field name="item_id" readonly="1"/>
                <field name="description" readonly="1"/>
                <field name="quantity" readonly="1"/>
                <field name="pm_approve_date" readonly="1"/>
            </tree>
        </field>
    </record>


    <!-- Action to open the list view of estimation model -->
    <record id="action_material_request_item" model="ir.actions.act_window">
        <field name="name">Material Request</field>
        <field name="res_model">material.request.item</field>
        <field name="view_mode">tree,form</field>
        <field name="view_id" ref="view_material_request_tree"/>
        <field name="context">{'create': False,'delete': False}</field>
        <field name="help" type="html">
            <p>
                Create and manage your Material Request
            </p>
        </field>
    </record>

    <record id="action_material_request_item_line" model="ir.actions.act_window">
        <field name="name">Material Request</field>
        <field name="res_model">material.request.line.item</field>
        <field name="view_mode">tree</field>
        <field name="view_id" ref="view_material_request_item_tree"/>
        <field name="domain">[('state', '=', 'approved')]</field>
        <field name="context">{'create': False,'delete': False}</field>
        <field name="help" type="html">
            <p>
                Create and manage your Material Request
            </p>
        </field>
    </record>

    <menuitem
            name="Material Request"
            id="menu_root_material_request"
            active="True"
            groups="arm_customization.group_material_requester,arm_customization.group_material_request_approver"
            web_icon="arm_customization,static/description/mrp.png"
            sequence="10">

        <menuitem
                name="Material Request"
                id="menu_material_request"
                action="action_material_request_item"
                sequence="12"
        />
    </menuitem>

    <menuitem
            name="Material Request"
            id="menu_material_request_purchase_order"
            action="action_material_request_item"
            parent="purchase.menu_procurement_management"
            sequence="10"
    />

    <menuitem
            name="Material Request Item"
            id="menu_material_request_purchase"
            action="action_material_request_item_line"
            parent="purchase.menu_procurement_management"
            sequence="12"
    />

</odoo>