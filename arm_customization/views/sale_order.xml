<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sale_order_form_view_inherited_arm" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.arm</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='payment_term_id']" position="after">
                <field name="estimated_amount" readonly="1"/>
                <field name="estimated_task" groups="arm_customization.group_admin_manager" readonly="1"/>
                <field name="parent_task" invisible="1"/>
                <field name="is_created" invisible="1"/>
                <field name="project_id" readonly="1" invisible="is_created == False"/>
                <field name="crm_id" readonly="1"/>
                <field name="job_reference" invisible="1"/>
                <field name="type_sale" invisible="1"/>
            </xpath>
            <xpath expr="//button[@name='action_quotation_send']" position="after">
                <button name="action_approve_form_accounts" type="object" string="Approve" class="oe_highlight"
                        invisible="state in ['revision','sale','cancel']" groups="arm_customization.group_account_approver"/>
                <button name="action_refuse_task_estimation" string="Revision"
                        type="object" class="oe_highlight" data-hotkey="o"
                        invisible="state in ['revision','sale','cancel']"
                />
                <button name="action_export_boq_item" type="object" string="Export Template" class="btn btn-primary"
                        invisible="1"/>
                <button name="action_boq_upload_item" type="object" string="Import BOQ Item" class="oe_highlight"
                        invisible="1"/>
                <button name="action_create_work_order" type="object" string="Create Work Order" class="oe_highlight"
                        invisible="state not in ['sale'] or is_created == True"
                        groups="arm_customization.group_work_order"/>
                <button name="action_invoice_per" type="object" string="Create Invoice" class="oe_highlight"
                        invisible="1"/>
            </xpath>
            <xpath expr="//button[@name='action_view_invoice']" position="after">
                <button name="action_view_sale_invoice"
                        type="object"
                         string="Invoices"
                        class="oe_stat_button"
                        icon="fa-pencil-square-o"
                        invisible="state not in ['sale']"
                >
                </button>
            </xpath>
            <xpath expr="//button[@name='action_confirm'][1]" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//button[@name='action_confirm'][2]" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//button[@id='create_invoice']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='client_order_ref']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='partner_shipping_id']" position="after">
                <field name="client_order_ref" string="LPO Number"/>
            </xpath>
            <xpath expr="//page[@name='order_lines']" position="after">
                <page string="Revision Lines" name="old_order_lines">
                    <field name="old_sale_ids" widget="one2many">
                        <tree string="Old Sales" editable="bottom">
                            <field name="name"/>
                            <field name="company_id" column_invisible="1"/>
                            <field name="partner_id"
                                   context="{'res_partner_search_mode': 'customer', 'show_address': 1, 'show_vat': True}"
                                   placeholder="Type to find a customer..." readonly="state in ['cancel', 'sale']"/>
                            <field name="amount_total"/>
                            <field name="state"/>
                        </tree>
                    </field>
                </page>
                <page string="Verified Lines" name="verified_oder_lines">
                    <field name="verified_lines" widget="one2many">
                        <tree string="Verification History" editable="0" create="0" delete="0">
                            <field name="sale_id" column_invisible="1"/>
                            <field name="name"/>
                            <field name="stage" widget="badge" decoration-success="stage == 'done'"/>
                            <field name="user_id"/>
                        </tree>
                    </field>
                </page>
            </xpath>
            <xpath expr="//page[@name='order_lines']/field[@name='order_line']/form/group/group/field[@name='qty_to_invoice']"
                   position="after">
                <field name="inv_total_amount" invisible="1" column_invisible="1"/>
                <field name="invoiced_percentage" readonly="1" column_invisible="1"/>
                <field name="balanced_percentage" readonly="1" column_invisible="1"/>
                <field name="total_qty_invoiced" readonly="1" column_invisible="1"/>
                <field name="total_amount_invoiced" column_invisible="1"/>
            </xpath>
            <xpath expr="//page[@name='order_lines']/field[@name='order_line']/tree/field[@name='qty_delivered']"
                   position="after">
                <field name="inv_total_amount" column_invisible="1"/>
                <field name="invoiced_percentage" readonly="1" column_invisible="1"/>
                <field name="balanced_percentage" readonly="1" column_invisible="1"/>
                <field name="total_qty_invoiced" readonly="1" column_invisible="1"/>
                <field name="total_amount_invoiced" column_invisible="1"/>
            </xpath>
        </field>
    </record>

    <record id="view_sales_order_filter_inherited" model="ir.ui.view">
        <field name="name">sale.order.list.inherited</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_sales_order_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="client_order_ref" string="Client Reference"
                       filter_domain="[('client_order_ref', 'ilike', self)]"/>
            </xpath>
        </field>
    </record>

</odoo>