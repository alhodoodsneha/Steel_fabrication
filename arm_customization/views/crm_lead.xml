<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="crm_lead_view_form_inherited_arm" model="ir.ui.view">
        <field name="name">crm.lead.view.form.inherit.arm</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_set_won_rainbowman']" position="after">
                <field name="assigned" invisible="1"/>
                <button name="action_assign_to_job_creation" string="Assign" groups="sales_team.group_sale_salesman"
                        type="object" class="oe_highlight" data-hotkey="o" invisible="assigned == True"/>
            </xpath>
            <xpath expr="//button[@name='action_set_won_rainbowman']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
             <xpath expr="//button[@name='%(crm.crm_lead_lost_action)d']" position="attributes">
                    <attribute name="invisible">1</attribute>
             </xpath>
            <xpath expr="//button[@name='action_schedule_meeting']" position="after">
                <button name="action_open_related_job" type="object"
                        string="Related Job" icon="fa-tasks"
                        class="btn-primary"
                />
                <button name="action_open_related_task" type="object"
                        string="Related Task" icon="fa-tasks"
                        class="btn-primary"
                />
            </xpath>
            <xpath expr="//field[@name='name']" position="before">
                <h1>
                    <field name="sequence_code" readonly="1"/>
                </h1>
            </xpath>
            <xpath expr="//group[@name='lead_partner']/field[@name='partner_id']" position="attributes">
                <attribute name="options">{'no_create_edit': True, 'no_open': True,'no_create': True}</attribute>
            </xpath>
            <xpath expr="//group[@name='opportunity_partner']/field[@name='partner_id']" position="attributes">
                <attribute name="options">{'no_create_edit': True, 'no_open': True,'no_create': True}</attribute>
            </xpath>
            <xpath expr="//field[@name='lost_reason_id']" position="after">
                <field name="job_name"/>
                <field name="job_status"/>
                <field name="project_job_id" readonly="1" invisible="1"/>
                <field name="enquiry_date"/>
                <field name="assigned" invisible="1"/>
            </xpath>
            <xpath expr="//field[@name='user_id']" position="after">
                <field name="quotation_type" readonly="1" widget="badge"/>
            </xpath>
            <xpath expr="//widget[@name='web_ribbon']" position="after">
                <widget name="web_ribbon" title="No Action Taken" bg_color="text-bg-info"
                        invisible="quotation_type != 'no_action_taken'"/>
                <widget name="web_ribbon" title="Waiting For Estimation" bg_color="text-bg-info"
                        invisible="quotation_type != 'waiting_for_estimation'"/>
                <widget name="web_ribbon" title="Estimation Completed" bg_color="text-bg-success"
                        invisible="quotation_type != 'estimation_completed'"/>
                <widget name="web_ribbon" title="Quote Submitted" bg_color="text-bg-warning"
                        invisible="quotation_type != 'quote_submitted'"/>
                <widget name="web_ribbon" title="Approved" bg_color="text-bg-success"
                        invisible="quotation_type != 'approved'"/>
            </xpath>
            <xpath expr="//label[@for='date_deadline']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//div[hasclass('o_lead_opportunity_form_inline_fields')]" position="before">
                <label for="date_deadline">Expiry Date</label>
            </xpath>
            <xpath expr="//field[@name='description']" position="after">
                <group string="Job Detail" name="job_detail">
                    <field name="project_detail" placeholder="Add a Job detail..." no_label="1"/>
                </group>
            </xpath>
        </field>
    </record>
    <record id="view_crm_lead_kanban_arm" model="ir.ui.view">
        <field name="name">crm.lead.kanban.inherit.arm</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_case_kanban_view_leads"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='priority']" position="after">
                <field name="quotation_type"/>
            </xpath>
            <xpath expr="//div[hasclass('oe_kanban_details')]" position="before">
                <div style="float:right;">
                    <field name="quotation_type" widget="badge"
                           decoration-success="quotation_type in[ 'approved','estimation_completed']"
                           decoration-warning="quotation_type == 'quote_submitted'"
                           decoration-info="quotation_type in['no_action_taken','waiting_for_estimation']"/>
                </div>
            </xpath>
        </field>
    </record>

    <record id="inherit_quick_create_opportunity_form_arm" model="ir.ui.view">
        <field name="name">crm.lead.form.quick_create.inherit.arm</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.quick_create_opportunity_form"/>
        <field name="arch" type="xml">
            <field name="partner_id" position="attributes">
                <attribute name="options">{'no_create_edit': True, 'no_open': True,'no_create': True}</attribute>
            </field>
        </field>
    </record>

    <record id="crm_case_form_view_oppor_inherited_arm" model="ir.ui.view">
        <field name="name">crm.lead.oppor.inherit.arm</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="sale_crm.crm_case_form_view_oppor"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_sale_quotations_new']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
        </field>
    </record>
    <record id="view_crm_arm_inherit_search" model="ir.ui.view">
        <field name="name">crm.lead.search.inherit.arm</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.view_crm_case_opportunities_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='user_id']" position="after">
                <field name="quotation_type"/>
            </xpath>
            <filter name="salesperson" position="after">
                <filter name="status" string="Status" context="{'group_by':'quotation_type'}"/>
            </filter>
        </field>
    </record>

    <record id="crm.menu_crm_opportunities" model="ir.ui.menu">
            <field name="name">Enquiry</field>
        </record>


    <record id="crm.crm_lead_action_pipeline_view_kanban" model="ir.actions.act_window.view">
        <field name="sequence" eval="1"/>
        <field name="view_mode">kanban</field>
        <field name="view_id" ref="crm.crm_case_kanban_view_leads"/>
        <field name="act_window_id" ref="crm.crm_lead_action_pipeline"/>
    </record>

    <record id="crm.crm_lead_action_pipeline_view_tree" model="ir.actions.act_window.view">
        <field name="sequence" eval="0"/>
        <field name="view_mode">tree</field>
        <field name="view_id" ref="crm.crm_case_tree_view_oppor"/>
        <field name="act_window_id" ref="crm.crm_lead_action_pipeline"/>
    </record>
    <record model="ir.actions.act_window" id="crm.crm_lead_action_pipeline">
        <field name="name">Enquiry</field>
        <field name="res_model">crm.lead</field>
        <field name="view_mode">tree,form,kanban,graph,pivot,calendar,activity</field>
        <field name="domain">[('type','=','opportunity')]</field>
        <field name="context">{
            'default_type': 'opportunity',
            'search_default_assigned_to_me': 1
            }
        </field>
        <field name="search_view_id" ref="crm.view_crm_case_opportunities_filter"/>
    </record>

    <record id="crm.res_partner_menu_customer" model="ir.ui.menu">
            <field name="action" ref="arm_customization.action_customer_view"/>
        </record>


</odoo>