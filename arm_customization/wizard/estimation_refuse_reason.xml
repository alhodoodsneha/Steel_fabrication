<?xml version="1.0" encoding="utf-8"?>
<odoo>
       <record id="estimation_rejection_wizard_form_view" model="ir.ui.view">
        <field name="name">estimation.rejection.wizard.form.view</field>
        <field name="model">estimation.rejection.wizard</field>
        <field name="arch" type="xml">
            <form string="ESTIMATION REJECTION FEEDBACK">
               <group>
                     <field name="feedback" required="1"/>
               </group>
                <footer>
                    <button name="action_add_feedback" type="object"
                            string="Done" class="btn-primary"/>
                    <button special="cancel" data-hotkey="z" string="Cancel"/>
                </footer>
            </form>
        </field>
    </record>

     <record id="action_estimation_rejection_wizard" model="ir.actions.act_window">
        <field name="name">Estimation Rejection Feedback</field>
        <field name="res_model">estimation.rejection.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="view_id" ref="estimation_rejection_wizard_form_view"/>
    </record>
</odoo>