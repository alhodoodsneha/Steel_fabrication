<?xml version="1.0" encoding="utf-8"?>
<odoo>
       <record id="create_delivery_wizard_form_view" model="ir.ui.view">
        <field name="name">create.delivery.wizard.form.view</field>
        <field name="model">create.delivery.wizard</field>
        <field name="arch" type="xml">
            <form string="Create Delivery">
               <group>
                     <field name="project_id" readonly="1"/>
                     <field name="task_ids" required="1" widget="many2many_tags"/>
               </group>
                <footer>
                    <button name="action_create_delivery_wrk" type="object"
                            string="Done" class="btn-primary"/>
                    <button special="cancel" data-hotkey="z" string="Cancel"/>
                </footer>
            </form>
        </field>
    </record>

     <record id="action_create_delivery_wizard" model="ir.actions.act_window">
        <field name="name">Create Delivery</field>
        <field name="res_model">create.delivery.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="view_id" ref="create_delivery_wizard_form_view"/>
    </record>
</odoo>