<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="advance_invoice_wizard_form_view" model="ir.ui.view">
        <field name="name">advance.invoice.wizard.form.view</field>
        <field name="model">advance.invoice.wizard</field>
        <field name="arch" type="xml">
            <form string="Create Invoice">
                <group>
                    <field name="project_id" readonly="1"/>
                </group>
                <group>
                </group>
                <notebook>
                    <page string="Invoice" name="invoice_items">
                        <field name="invoice_line_ids" widget="one2many">
                            <tree string="Invoice Lines" editable="bottom" create="0" delete="0">
                                <field name="wizard_id" column_invisible="1"/>
                                <field name="boq_id" column_invisible="1"/>
                                <field name="product_id" readonly="1"/>
                                <field name="uom" readonly="1"/>
                                <field name="quantity" readonly="1"/>
                                <field name="unit_price" readonly="1"/>
                                <field name="subtotal" readonly="1"/>
                                <field name="invoiced_percentage" readonly="1"/>
                                <field name="balance_percentage" readonly="1"/>
                                <field name="to_invoice_percentage" />
                                <field name="invoice_price" readonly="1" force_save="1"/>
                            </tree>
                        </field>
                    </page>
                </notebook>
                <footer>
                    <button name="action_adv_create_adv" type="object"
                            string="Done" class="btn-primary"/>
                    <button special="cancel" data-hotkey="z" string="Cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_advance_invoice_wizard" model="ir.actions.act_window">
        <field name="name">Create Invoice</field>
        <field name="res_model">advance.invoice.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="view_id" ref="advance_invoice_wizard_form_view"/>
    </record>
</odoo>